# Copy to .env for local runs (`cp .env.example .env`). Never commit .env.
# In GitHub Actions set these as repository secrets instead.

# Your ScrapeUnblocker API key: https://scrapeunblocker.com/?utm_source=github&utm_medium=integration&utm_campaign=example-repos
SCRAPEUNBLOCKER_KEY=your_key_here

# Set at least one destination. Unset ones are skipped.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
